# ─────────────────────────────────────────────────────────────────────────────
# Society Management Portal — Backend Environment Variables
# Copy this file to .env and fill in the values before starting the server.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Local (Docker Compose):  postgresql://society_user:society_pass@db:5432/society_db
# Local (bare metal):      postgresql://society_user:society_pass@localhost:5432/society_db
# Production (managed DB): postgresql://user:pass@your-db-host:5432/society_db?sslmode=require
DATABASE_URL=postgresql://society_user:society_pass@localhost:5432/society_db

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# Set to "production" when deploying. Affects:
#   - JWT secret strength enforcement (exits on weak secret in production)
#   - Stack traces hidden from API error responses
#   - Console log verbosity
NODE_ENV=development

# ─── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 random characters.
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# WARNING: The server will refuse to start in production if this is weak or default.
JWT_SECRET=CHANGE_ME_use_a_random_32plus_char_string

# Token lifetimes — use ms/s/m/h/d notation (jsonwebtoken format)
JWT_EXPIRES_IN=8h
JWT_DEFAULT_TTL=1d
JWT_REMEMBER_TTL=30d
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local:       http://localhost:5173
# Production:  https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ─── File Uploads / Storage ──────────────────────────────────────────────────
# Storage driver: "local" stores files on disk inside the container.
# Use "s3" for AWS S3 / S3-compatible storage in production.
STORAGE_DRIVER=local

# Local upload directory (used when STORAGE_DRIVER=local)
UPLOAD_DIR=/uploads

# AWS S3 — required only when STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET=society-uploads

# ─── Email (Password Reset / SMTP) ───────────────────────────────────────────
# When SMTP_HOST is NOT set, the server logs email content to the console
# instead of sending (safe for local development).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Society Portal <noreply@example.com>

# ─── Society Portal Domain ───────────────────────────────────────────────────
# The root domain used to construct per-society subdomain URLs.
# e.g. "societyportal.app" → slug "green-valley" → https://green-valley.societyportal.app
PORTAL_DOMAIN=societyportal.app
