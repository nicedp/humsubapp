# ─────────────────────────────────────────────────────────────────────────────
# Society Management Portal — Frontend Environment Variables
# Copy this file to .env (local dev) or .env.prod (production build).
#   cp .env.example .env
#
# IMPORTANT: Vite bakes VITE_* variables into the JS bundle at BUILD TIME.
# Changing this file after a build has no effect — you must rebuild.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend API base URL ─────────────────────────────────────────────────────
# The URL the browser uses to reach the backend API.
#
# Local development (Docker Compose):
#   Leave blank — Vite's dev server proxies /api/* to http://backend:3000
#   and VITE_API_URL is not needed.
#
# Local development (bare metal, no Docker):
#   VITE_API_URL=http://localhost:3000
#
# Production (nginx reverse proxy — recommended):
#   The nginx reverse proxy routes /api/* to the backend container, so the
#   browser calls the same domain — no separate API URL needed.
#   VITE_API_URL=https://yourdomain.com
#
# Production (separate API subdomain):
#   VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=http://localhost:3000
