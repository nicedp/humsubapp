# ─────────────────────────────────────────────────────────────────────────────
# Society Management Portal — Frontend Dockerfile (Production)
# Multi-stage build:
#   Stage 1 (builder) — installs deps, builds static assets via Vite
#   Stage 2 (runner)  — nginx serves the static files; no Node.js at runtime
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first — Docker cache layer optimisation
COPY package*.json ./
RUN npm ci

# Copy source files
COPY . .

# VITE_API_URL must be set at build time (baked into the JS bundle).
# Pass it via --build-arg in docker-compose or docker build:
#   docker build --build-arg VITE_API_URL=https://api.yourdomain.com .
ARG VITE_API_URL=http://localhost:3000
ENV VITE_API_URL=$VITE_API_URL

# Build production static files into /app/dist
RUN npm run build

# ── Stage 2: Runner (nginx) ───────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our SPA-aware nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
